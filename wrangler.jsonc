{
  "name": "brothers-kingdoms",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "KingdomRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "KingdomRoom"
      ]
    }
  ],
  "build": {
    "command": "node scripts/build-cloudflare.cjs"
  }
}
